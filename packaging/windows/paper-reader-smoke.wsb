<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Disable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <ProtectedClient>Enable</ProtectedClient>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\paper-reader-sandbox</HostFolder>
      <SandboxFolder>C:\paper-reader-input</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\paper-reader-sandbox-output</HostFolder>
      <SandboxFolder>C:\paper-reader-output</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$env:RUNNER_TEMP='C:\paper-reader-output'; &amp; C:\paper-reader-input\clean-smoke.ps1 -ReleaseDirectory C:\paper-reader-input\release -ExpectedManifestSha256 REPLACE_WITH_64_LOWERCASE_SHA256"</Command>
  </LogonCommand>
</Configuration>
